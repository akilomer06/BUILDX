FROM python:3.14-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-lock.txt pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements-lock.txt && pip install --no-cache-dir --no-deps . \
    && useradd --create-home --uid 10001 veilmint && mkdir /data
COPY scripts/render_entrypoint.py /app/render_entrypoint.py
ENV VEILMINT_DB=/data/synthetic-demo.sqlite3
EXPOSE 10000
# Root only initializes ephemeral data ownership; entrypoint drops privileges before serving.
ENTRYPOINT ["python", "/app/render_entrypoint.py"]
