# Local synthetic demo only. Compose reads this after copying to .env.
# The Python CLI does not automatically read .env; set shell environment locally.
VEILMINT_MODE=OBSERVE
# Opt in only for volatile sandbox response inspection. Keep false in production.
VEILMINT_RESPONSE_INSPECTION_DEMO=false
VEILMINT_WEB_PORT=8080
# Optional for local Python runs (Compose sets its own volume path):
VEILMINT_DB=data/synthetic-demo.sqlite3
# Leave empty with the default mapping. HMAC mode requires >=32 bytes supplied
# externally. Never commit a real key. Generate locally with Python secrets.
VEILMINT_HMAC_KEY=
# Generate a local secret with python scripts/configure_bank.py (never commit it).
VEILMINT_OPERATOR_TOKEN=
# Customer app is host-only until configure_bank.py --lan is explicitly run.
LAN_DEMO=false
NEXUS_BIND=127.0.0.1
NEXUS_WEB_PORT=8081
NEXUS_MODE=ENFORCE
# False only for isolated HTTP sandbox demos; use true behind HTTPS.
NEXUS_SECURE_COOKIE=false
